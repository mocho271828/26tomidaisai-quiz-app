APP_ENV=local-demo
POSTGRES_PASSWORD=local-only-database-password
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8080
REALTIME_ALLOWED_ORIGINS=["http://localhost:8080"]
DEMO_OPERATOR_USERNAME=demo-operator
DEMO_OPERATOR_PASSWORD=replace-for-local-review
SESSION_SECRET=replace-for-local-review-with-at-least-32-characters
ROUND_BACKUP_STORAGE_MODE=filesystem
ROUND_BACKUP_DIRECTORY=/var/lib/quiz-round-backups
# 初回は make local-env で端末ごとの鍵を生成します。
ROUND_BACKUP_ENCRYPTION_KEY=
ENABLE_DEMO_AUTH=true
ENABLE_DEMO_SEED=true
SESSION_COOKIE_SECURE=false
LOGFIRE_SEND_TO_LOGFIRE=false
VITE_EVENT_START_AT=
VITE_SURVEY_URL=
VITE_HOME_URL=
