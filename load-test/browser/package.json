{
  "name": "@tomidaisai/local-browser-retest",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "run": "node dist/src/main.js",
    "control": "node dist/src/control.js",
    "control:report": "node dist/src/controlReport.js",
    "runner:new": "node dist/src/createRunner.js",
    "aws:run": "node dist/src/aws.js",
    "lan:check": "node dist/src/lan.js check",
    "lan:50": "node dist/src/lan.js run --vus 50",
    "lan:600": "node dist/src/lan.js run --vus 600"
  },
  "dependencies": {
    "playwright": "1.63.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.35.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.15.1"
}
