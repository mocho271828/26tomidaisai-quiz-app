                  "Effect": "Allow",
                  "Action": [
                    "states:DescribeExecution"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:states:${AWS::Region}:${AWS::AccountId}:execution:${Prefix}-cleanup:cleanup"
                  }
                }
              ]
            }
          }
