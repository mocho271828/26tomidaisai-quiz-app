{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadEc2",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeAccountAttributes",
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeIamInstanceProfileAssociations",
        "ec2:DescribeImages",
        "ec2:DescribeInstanceAttribute",
        "ec2:DescribeInstanceCreditSpecifications",
        "ec2:DescribeInstances",
        "ec2:DescribeInternetGateways",
        "ec2:DescribeKeyPairs",
        "ec2:DescribeLaunchTemplateVersions",
        "ec2:DescribeLaunchTemplates",
        "ec2:DescribeNetworkAcls",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeRouteTables",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets",
        "ec2:DescribeVolumes",
        "ec2:DescribeVpcAttribute",
        "ec2:DescribeVpcEncryptionControls",
        "ec2:DescribeVpcs",
        "ec2:DescribeVpnGateways"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${Region}"
        }
      }
    },
    {
      "Sid": "CreateTaggedNetwork",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateInternetGateway",
        "ec2:CreateVpc"
      ],
      "Resource": [
        "arn:aws:ec2:${Region}:${Account}:internet-gateway/*",
        "arn:aws:ec2:${Region}:${Account}:vpc/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "gs-app-tomidaisai",
          "aws:RequestTag/RunId": "${RunId}"
        }
      }
    },
    {
      "Sid": "CreateTaggedVpcChildren",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateRouteTable",
        "ec2:CreateSecurityGroup",
        "ec2:CreateSubnet"
      ],
      "Resource": [
        "arn:aws:ec2:${Region}:${Account}:route-table/*",
        "arn:aws:ec2:${Region}:${Account}:security-group/*",
        "arn:aws:ec2:${Region}:${Account}:subnet/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "gs-app-tomidaisai",
          "aws:RequestTag/RunId": "${RunId}"
        }
      }
    },
    {
      "Sid": "CreateChildrenInOwnedVpc",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateRouteTable",
        "ec2:CreateSecurityGroup",
        "ec2:CreateSubnet"
      ],
      "Resource": "arn:aws:ec2:${Region}:${Account}:vpc/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Project": "gs-app-tomidaisai",
          "ec2:ResourceTag/RunId": "${RunId}"
        }
      }
    },
    {
      "Sid": "RunTaggedCompute",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": [
        "arn:aws:ec2:${Region}:${Account}:instance/*",
        "arn:aws:ec2:${Region}:${Account}:volume/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "gs-app-tomidaisai",
          "aws:RequestTag/RunId": "${RunId}"
        }
      }
    },
    {
      "Sid": "RunOwnedNetwork",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": [
        "arn:aws:ec2:${Region}:${Account}:subnet/*",
        "arn:aws:ec2:${Region}:${Account}:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Project": "gs-app-tomidaisai",
          "ec2:ResourceTag/RunId": "${RunId}"
        }
      }
    },
    {
      "Sid": "RunImageAndNewInterface",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": [
        "arn:aws:ec2:${Region}::image/${AmiId}",
        "arn:aws:ec2:${Region}:${Account}:network-interface/*"
      ]
    },
    {
      "Sid": "TagCreatedNetwork",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags"
      ],
      "Resource": "arn:aws:ec2:${Region}:${Account}:*/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "gs-app-tomidaisai",
          "aws:RequestTag/RunId": "${RunId}",
          "ec2:CreateAction": [
            "CreateInternetGateway",
            "CreateRouteTable",
            "CreateSecurityGroup",
            "CreateSubnet",
            "CreateVpc",
            "RunInstances"
          ]
        }
      }
    },
    {
      "Sid": "TagOwnedNetwork",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags"
      ],
      "Resource": "arn:aws:ec2:${Region}:${Account}:*/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "gs-app-tomidaisai",
          "aws:RequestTag/RunId": "${RunId}",
          "ec2:ResourceTag/Project": "gs-app-tomidaisai",
          "ec2:ResourceTag/RunId": "${RunId}"
        }
      }
    },
    {
      "Sid": "ManageOwnedNetwork",
      "Effect": "Allow",
      "Action": [
        "ec2:AssociateIamInstanceProfile",
        "ec2:AssociateRouteTable",
        "ec2:AttachInternetGateway",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:CreateRoute",
        "ec2:DeleteInternetGateway",
        "ec2:DeleteRoute",
        "ec2:DeleteRouteTable",
        "ec2:DeleteSecurityGroup",
        "ec2:DeleteSubnet",
        "ec2:DeleteVpc",
        "ec2:DetachInternetGateway",
        "ec2:DisassociateIamInstanceProfile",
        "ec2:DisassociateRouteTable",
        "ec2:ModifyInstanceAttribute",
        "ec2:ModifyPrivateDnsNameOptions",
        "ec2:ModifySubnetAttribute",
        "ec2:ModifyVpcAttribute",
        "ec2:ReplaceRouteTableAssociation",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:TerminateInstances"
      ],
      "Resource": "arn:aws:ec2:${Region}:${Account}:*/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Project": "gs-app-tomidaisai",
          "ec2:ResourceTag/RunId": "${RunId}"
        }
      }
    },
    {
      "Sid": "PassRunRoles",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::${Account}:role/${Prefix}-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "ec2.amazonaws.com",
            "lambda.amazonaws.com",
            "states.amazonaws.com",
            "scheduler.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "ServiceLinkedRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateServiceLinkedRole"
      ],
      "Resource": [
        "arn:aws:iam::${Account}:role/aws-service-role/rds.amazonaws.com/*",
        "arn:aws:iam::${Account}:role/aws-service-role/elasticache.amazonaws.com/*"
      ],
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": [
            "rds.amazonaws.com",
            "elasticache.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "ReadRoles",
      "Effect": "Allow",
      "Action": [
        "iam:ListRoles"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RunRolesAndProfiles",
      "Effect": "Allow",
      "Action": [
        "iam:AddRoleToInstanceProfile",
        "iam:CreateInstanceProfile",
        "iam:CreateRole",
        "iam:DeleteInstanceProfile",
        "iam:DeleteRole",
        "iam:DeleteRolePolicy",
        "iam:GetInstanceProfile",
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies",
        "iam:PutRolePolicy",
        "iam:RemoveRoleFromInstanceProfile",
        "iam:TagRole",
        "iam:UntagRole"
      ],
      "Resource": [
        "arn:aws:iam::${Account}:role/${Prefix}-*",
        "arn:aws:iam::${Account}:instance-profile/${Prefix}-*"
      ]
    },
    {
      "Sid": "SsmManagedPolicy",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "arn:aws:iam::${Account}:role/${Prefix}-*",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
        }
      }
    },
    {
      "Sid": "ManageEcr",
      "Effect": "Allow",
      "Action": [
        "ecr:CreateRepository",
        "ecr:DeleteRepository",
        "ecr:DescribeRepositories",
        "ecr:GetLifecyclePolicy",
        "ecr:GetRepositoryPolicy",
        "ecr:ListTagsForResource",
        "ecr:TagResource"
      ],
      "Resource": "arn:aws:ecr:${Region}:${Account}:repository/${Prefix}/*"
    },
    {
      "Sid": "ReadElasticache",
      "Effect": "Allow",
      "Action": [
        "elasticache:DescribeCacheSubnetGroups",
        "elasticache:DescribeReplicationGroups",
        "elasticache:DescribeUserGroups",
        "elasticache:DescribeUsers"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${Region}"
        }
      }
    },
    {
      "Sid": "ManageElasticache",
      "Effect": "Allow",
      "Action": [
        "elasticache:AddTagsToResource",
        "elasticache:CreateCacheSubnetGroup",
        "elasticache:CreateReplicationGroup",
        "elasticache:CreateUser",
        "elasticache:CreateUserGroup",
        "elasticache:DeleteCacheSubnetGroup",
        "elasticache:DeleteReplicationGroup",
        "elasticache:DeleteUser",
        "elasticache:DeleteUserGroup",
        "elasticache:ListTagsForResource",
        "elasticache:ModifyReplicationGroup"
      ],
      "Resource": [
        "arn:aws:elasticache:${Region}:${Account}:replicationgroup:${Prefix}",
        "arn:aws:elasticache:${Region}:${Account}:subnetgroup:${Prefix}-*",
        "arn:aws:elasticache:${Region}:${Account}:parametergroup:default.redis7",
        "arn:aws:elasticache:${Region}:${Account}:user:${Prefix}a",
        "arn:aws:elasticache:${Region}:${Account}:user:${Prefix}m",
        "arn:aws:elasticache:${Region}:${Account}:usergroup:${Prefix}u"
      ]
    },
    {
      "Sid": "ManageEvents",
      "Effect": "Allow",
      "Action": [
        "events:DeleteRule",
        "events:DescribeRule",
        "events:ListTagsForResource",
        "events:ListTargetsByRule",
        "events:PutRule",
        "events:PutTargets",
        "events:RemoveTargets",
        "events:TagResource"
      ],
      "Resource": "arn:aws:events:${Region}:${Account}:rule/${Prefix}-*"
    },
    {
      "Sid": "ReadLogs",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeIndexPolicies",
        "logs:DescribeLogGroups",
        "logs:DescribeResourcePolicies",
        "logs:ListLogDeliveries"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${Region}"
        }
      }
    },
    {
      "Sid": "ManageLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:ListTagsForResource",
        "logs:PutRetentionPolicy",
        "logs:TagResource"
      ],
      "Resource": [
        "arn:aws:logs:${Region}:${Account}:log-group:/aws/lambda/${Prefix}-cleanup",
        "arn:aws:logs:${Region}:${Account}:log-group:/aws/lambda/${Prefix}-cleanup:*"
      ]
    },
    {
      "Sid": "ReadRds",
      "Effect": "Allow",
      "Action": [
        "rds:DescribeDBClusterSnapshots",
        "rds:DescribeDBClusters",
        "rds:DescribeDBInstanceAutomatedBackups",
        "rds:DescribeDBInstances",
        "rds:DescribeDBSnapshots",
        "rds:DescribeDBSubnetGroups",
        "rds:DescribeEvents",
        "rds:ListTagsForResource"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${Region}"
        }
      }
    },
    {
      "Sid": "ManageRds",
      "Effect": "Allow",
      "Action": [
        "rds:AddTagsToResource",
        "rds:CreateDBInstance",
        "rds:CreateDBSubnetGroup",
        "rds:DeleteDBInstance",
        "rds:DeleteDBSubnetGroup",
        "rds:ModifyDBInstance",
        "rds:RemoveTagsFromResource"
      ],
      "Resource": [
        "arn:aws:rds:${Region}:${Account}:db:${Prefix}-*",
        "arn:aws:rds:${Region}:${Account}:subgrp:${Prefix}-*",
        "arn:aws:rds:${Region}:${Account}:pg:default.postgres16",
        "arn:aws:rds:${Region}:${Account}:og:default:postgres-16"
      ]
    },
    {
      "Sid": "ManageS3",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:DeleteObject",
        "s3:GetAccelerateConfiguration",
        "s3:GetAnalyticsConfiguration",
        "s3:GetBucketAbac",
        "s3:GetBucketAcl",
        "s3:GetBucketCORS",
        "s3:GetBucketLogging",
        "s3:GetBucketMetadataTableConfiguration",
        "s3:GetBucketNotification",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetBucketOwnershipControls",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketTagging",
        "s3:GetBucketVersioning",
        "s3:GetBucketWebsite",
        "s3:GetEncryptionConfiguration",
        "s3:GetIntelligentTieringConfiguration",
        "s3:GetInventoryConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:GetMetricsConfiguration",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetReplicationConfiguration",
        "s3:ListBucket",
        "s3:ListTagsForResource",
        "s3:PutBucketOwnershipControls",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketTagging",
        "s3:PutBucketVersioning",
        "s3:PutEncryptionConfiguration",
        "s3:PutLifecycleConfiguration",
        "s3:TagResource"
      ],
      "Resource": [
        "arn:aws:s3:::${Prefix}-${Account}",
        "arn:aws:s3:::${Prefix}-${Account}/*"
      ]
    },
    {
      "Sid": "ManageScheduler",
      "Effect": "Allow",
      "Action": [
        "scheduler:CreateSchedule",
        "scheduler:CreateScheduleGroup",
        "scheduler:DeleteSchedule",
        "scheduler:DeleteScheduleGroup",
        "scheduler:GetSchedule",
        "scheduler:GetScheduleGroup",
        "scheduler:ListTagsForResource",
        "scheduler:TagResource"
      ],
      "Resource": [
        "arn:aws:scheduler:${Region}:${Account}:schedule-group/${Prefix}",
        "arn:aws:scheduler:${Region}:${Account}:schedule/${Prefix}/*"
      ]
    },
    {
      "Sid": "GeneratePasswords",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetRandomPassword"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${Region}"
        }
      }
    },
    {
      "Sid": "ManageSecretsmanager",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:CreateSecret",
        "secretsmanager:DeleteSecret",
        "secretsmanager:DescribeSecret",
        "secretsmanager:GetSecretValue",
        "secretsmanager:TagResource"
      ],
      "Resource": "arn:aws:secretsmanager:${Region}:${Account}:secret:${Prefix}/*"
    },
    {
      "Sid": "ManageSns",
      "Effect": "Allow",
      "Action": [
        "sns:CreateTopic",
        "sns:DeleteTopic",
        "sns:GetDataProtectionPolicy",
        "sns:GetSubscriptionAttributes",
        "sns:GetTopicAttributes",
        "sns:ListSubscriptionsByTopic",
        "sns:ListTagsForResource",
        "sns:PutDataProtectionPolicy",
        "sns:SetTopicAttributes",
        "sns:Subscribe",
        "sns:TagResource",
        "sns:Unsubscribe"
      ],
      "Resource": [
        "arn:aws:sns:${Region}:${Account}:${Prefix}-*",
        "arn:aws:sns:${Region}:${Account}:${Prefix}-*:*"
      ]
    },
    {
      "Sid": "ManageSqs",
      "Effect": "Allow",
      "Action": [
        "sqs:CreateQueue",
        "sqs:DeleteQueue",
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl",
        "sqs:ListQueueTags",
        "sqs:TagQueue"
      ],
      "Resource": "arn:aws:sqs:${Region}:${Account}:${Prefix}-*"
    },
    {
      "Sid": "ReadSsm",
      "Effect": "Allow",
      "Action": [
        "ssm:DescribeAssociation",
        "ssm:DescribeDocument",
        "ssm:ListAssociations"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${Region}"
        }
      }
    },
    {
      "Sid": "ManageSsm",
      "Effect": "Allow",
      "Action": [
        "ssm:AddTagsToResource",
        "ssm:CreateDocument",
        "ssm:DeleteDocument",
        "ssm:GetDocument",
        "ssm:ListTagsForResource"
      ],
      "Resource": "arn:aws:ssm:${Region}:${Account}:document/${Prefix}-*"
    },
    {
      "Sid": "ManageStates",
      "Effect": "Allow",
      "Action": [
        "states:CreateStateMachine",
        "states:DeleteStateMachine",
        "states:DescribeStateMachine",
        "states:ListTagsForResource",
        "states:TagResource"
      ],
      "Resource": "arn:aws:states:${Region}:${Account}:stateMachine:${Prefix}-*"
    },
    {
      "Sid": "UpdateRunCleanupStateMachine",
      "Effect": "Allow",
      "Action": [
        "states:UpdateStateMachine"
      ],
      "Resource": "arn:aws:states:${Region}:${Account}:stateMachine:${Prefix}-cleanup"
    },
    {
      "Sid": "ReadServiceLinkedRoles",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole"
      ],
      "Resource": [
        "arn:aws:iam::${Account}:role/aws-service-role/rds.amazonaws.com/*",
        "arn:aws:iam::${Account}:role/aws-service-role/elasticache.amazonaws.com/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "scheduler:GetSchedule"
      ],
      "Resource": "arn:aws:scheduler:${Region}:${Account}:schedule/default/${Prefix}-deadline",
      "Sid": "ReadRunScheduleNameConflictProbe"
    }
  ]
}
